{
  "openapi": "3.1.0",
  "info": {
    "title": "HOPPIT · telemetria y seguimiento",
    "description": "Servicio de telemetria y seguimiento de HOPPIT (ARQ-52, ARQ-53, ARQ-59). Recibe las posiciones de las Rutas en ejecucion, publica la ultima con su antiguedad y recibe los eventos del nucleo por la salida transaccional, en una ruta que el borde no expone.",
    "version": "1.0.0"
  },
  "paths": {
    "/estado": {
      "get": {
        "tags": [
          "Servicio"
        ],
        "summary": "Version y salud",
        "operationId": "estado_estado_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstadoDeTelemetria"
                }
              }
            }
          }
        }
      }
    },
    "/v1/telemetria/lotes": {
      "post": {
        "tags": [
          "Telemetria"
        ],
        "summary": "Recibir un lote de posiciones del dispositivo (seccion 3.2)",
        "description": "Token de transportista, terminos vigentes y consentimiento de\ngeolocalizacion. Cada posicion se acepta, se descarta por repetida o\nse rechaza con su motivo, y se acepta por instante de captura, no de\nllegada. Los motivos de rechazo son `identificador_invalido` (el `id`\nno es un UUID version 4 en forma canonica), `ejecucion_desconocida`\n(el unico reintentable), `ruta_no_asignada`, `fuera_de_ejecucion`,\n`marca_temporal_invalida` y `coordenadas_invalidas`.",
        "operationId": "recibir_lote_v1_telemetria_lotes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteSolicitado"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoteClasificado"
                }
              }
            }
          },
          "401": {
            "description": "`no_autenticado` o `sesion_vencida`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "403": {
            "description": "`rol_no_autorizado` o `terminos_no_aceptados`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "413": {
            "description": "`lote_demasiado_grande`: mas de 100 posiciones o mas de 65536 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "422": {
            "description": "`peticion_mal_formada` si el cuerpo no cumple el esquema, o `dispositivo_invalido` si el `dispositivo_id` no es un UUID version 4 en forma canonica.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "503": {
            "description": "`base_no_disponible`: la aplicacion reintenta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          }
        }
      }
    },
    "/v1/telemetria/rutas/{ruta_id}/ultima-posicion": {
      "get": {
        "tags": [
          "Telemetria"
        ],
        "summary": "Ultima posicion de una Ruta y su antiguedad (FR-17)",
        "description": "Para la interfaz del operador, que la superpone sobre la Ruta que\nobtiene del nucleo.",
        "operationId": "ultima_posicion_v1_telemetria_rutas__ruta_id__ultima_posicion_get",
        "parameters": [
          {
            "name": "ruta_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ruta Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UltimaPosicionPublicada"
                }
              }
            }
          },
          "401": {
            "description": "`no_autenticado` o `sesion_vencida`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "403": {
            "description": "`rol_no_autorizado` o `terminos_no_aceptados`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "404": {
            "description": "`sin_posiciones`: la Ruta no tiene ninguna posicion informada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interno/rutas/{ruta_id}/ultima-posicion": {
      "get": {
        "tags": [
          "Interno"
        ],
        "summary": "Ultima posicion de una Ruta para el nucleo (CU-07, paso 3; CU-09)",
        "description": "La misma respuesta que la del operador, con token de servicio del\nnucleo: es como el nucleo lee la posicion para replanificar (17B, C.1,\ncamino a). Una Ruta reemplazada responde con la de la vigente.",
        "operationId": "ultima_posicion_interna_interno_rutas__ruta_id__ultima_posicion_get",
        "parameters": [
          {
            "name": "ruta_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ruta Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UltimaPosicionPublicada"
                }
              }
            }
          },
          "401": {
            "description": "`no_autenticado`: falta el token de servicio o no es valido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "404": {
            "description": "`sin_posiciones`: la Ruta no tiene ninguna posicion informada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/interno/rutas/{ruta_id}/posiciones-recientes": {
      "get": {
        "tags": [
          "Interno"
        ],
        "summary": "Posiciones recientes de la Ruta vigente para el nucleo (reruteo por desvio)",
        "description": "Las capturadas en los ultimos `segundos`, en orden de captura (a lo\nsumo 20); una Ruta reemplazada responde con las de la vigente. Lista\nvacia si no hay.",
        "operationId": "posiciones_recientes_internas_interno_rutas__ruta_id__posiciones_recientes_get",
        "parameters": [
          {
            "name": "ruta_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ruta Id"
            }
          },
          {
            "name": "segundos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 3600,
              "exclusiveMinimum": 0,
              "default": 120.0,
              "title": "Segundos"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PosicionRecientePublicada"
                  },
                  "title": "Response Posiciones Recientes Internas Interno Rutas  Ruta Id  Posiciones Recientes Get"
                }
              }
            }
          },
          "401": {
            "description": "`no_autenticado`: falta el token de servicio o no es valido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "422": {
            "description": "`peticion_mal_formada` si `segundos` no es positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          }
        }
      }
    },
    "/interno/eventos": {
      "post": {
        "tags": [
          "Interno"
        ],
        "summary": "Eventos del nucleo por la salida transaccional (ARQ-59)",
        "description": "Con token de servicio del nucleo. Un evento repetido se descarta.",
        "operationId": "recibir_evento_interno_eventos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventoSolicitado"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoRegistrado"
                }
              }
            }
          },
          "401": {
            "description": "`no_autenticado`: falta el token de servicio o no es valido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "409": {
            "description": "`secuencia_fuera_de_orden`: el nucleo reintenta en orden.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          },
          "422": {
            "description": "`evento_desconocido` o `peticion_mal_formada`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorPublicado"
                }
              }
            }
          }
        }
      }
    }
  },
